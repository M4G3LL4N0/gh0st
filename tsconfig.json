{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@gh0st/core": ["packages/core/src"],
      "@gh0st/xai": ["packages/xai/src"],
      "@gh0st/security": ["packages/security/src"],
      "@gh0st/storage": ["packages/storage/src"],
      "@gh0st/files": ["packages/files/src"],
      "@gh0st/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}