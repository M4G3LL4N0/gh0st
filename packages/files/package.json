{
  "name": "@gh0st/files",
  "version": "1.0.0",
  "description": "File extraction, indexing, and retrieval for gh0st",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --reporter=verbose",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gh0st/core": "workspace:*",
    "@gh0st/security": "workspace:*",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}