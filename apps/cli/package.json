{
  "name": "@gh0st/cli",
  "version": "1.0.0",
  "description": "gh0st CLI and local browser server",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gh0st": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --reporter=verbose",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gh0st/core": "workspace:*",
    "@gh0st/security": "workspace:*",
    "@gh0st/storage": "workspace:*",
    "@gh0st/files": "workspace:*",
    "@gh0st/xai": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "marked": "^11.2.0",
    "marked-terminal": "^7.0.0",
    "ws": "^8.17.0",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.15.0"
  }
}