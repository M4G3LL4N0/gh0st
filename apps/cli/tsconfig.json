{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@gh0st/core": ["../../packages/core/dist"],
      "@gh0st/security": ["../../packages/security/dist"],
      "@gh0st/storage": ["../../packages/storage/dist"],
      "@gh0st/xai": ["../../packages/xai/dist"],
      "@gh0st/files": ["../../packages/files/dist"],
      "@gh0st/ui": ["../../packages/ui/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}