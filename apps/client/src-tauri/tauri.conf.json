{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gh0st",
  "version": "1.0.0",
  "identifier": "dev.gh0st",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gh0st",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Private AI client",
    "longDescription": "gh0st - Private AI client. Local-first, encrypted, xAI-powered.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "providerShortName": "gh0st",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "stronghold": null,
    "dialog": null,
    "fs": null,
    "notification": null,
    "globalShortcut": null,
    "clipboard": null,
    "shell": {
      "open": true
    },
    "windowState": null,
    "opener": null
  }
}
